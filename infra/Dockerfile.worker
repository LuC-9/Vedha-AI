# Playwright + AgentQL Autonomous Worker Container
FROM mcr.microsoft.com/playwright/python:v1.49.0-jammy

WORKDIR /app

# Set non-interactive environment and resilient pip defaults
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PIP_DEFAULT_TIMEOUT=300
ENV PIP_RETRIES=10

# Copy requirements and install python packages with extended timeout and retry tolerance
COPY workers/playwright-agent/requirements.txt /app/
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir --default-timeout=300 --retries=10 -r requirements.txt

# Install Playwright browser dependencies (ensure chromium is ready)
RUN playwright install chromium

# Pre-fetch the Patchright stealth browser (default WORKER_STEALTH_ENGINE);
# falls back to stock Chromium at runtime if the fetch is unavailable.
# Camoufox (alternate engine) fetches its browser lazily on first use.
RUN patchright install chromium || echo "patchright browser pre-fetch skipped; runtime fallback applies"

# Copy worker application code
COPY workers/playwright-agent/ /app/

CMD ["python", "main.py"]
